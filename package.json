{
  "name": "mmd-parser",
  "version": "1.1.1",
  "description": "MMD parser",
  "main": "build/mmdparser.js",
  "jsnext:main": "build/mmdparser.module.js",
  "exports": {
    ".": {
      "import": {
        "types": "./build/types/index.d.mts",
        "default": "./build/mmdparser.module.mjs"
      },
      "require": {
        "types": "./build/types/index.d.ts",
        "default": "./build/mmdparser.js"
      },
      "default": "./build/mmdparser.js"
    },
    "./build/mmdparser.js": "./build/mmdparser.js",
    "./build/mmdparser.min.js": "./build/mmdparser.min.js",
    "./build/mmdparser.module.js": "./build/mmdparser.module.js",
    "./build/mmdparser.module.mjs": "./build/mmdparser.module.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "all": "npm run build-uglify && npm run typecheck && npm run test:offline && npm test",
    "build": "tsc && rollup -c && node scripts/copy-types.js",
    "build-uglify": "npm run build && uglifyjs build/mmdparser.js -cm --preamble \"// https://github.com/takahirox/mmd-parser#readme\" > build/mmdparser.min.js",
    "dev": "node scripts/dev.js",
    "test": "node test/index.js",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "test:offline": "node test/offline.js",
    "test:package": "node scripts/test-package.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takahirox/mmd-parser.git"
  },
  "author": "Takahiro <hogehoge@gachapin.jp> (https://github.com/takahirox)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/takahirox/mmd-parser/issues"
  },
  "homepage": "https://github.com/takahirox/mmd-parser#readme",
  "devDependencies": {
    "charset-encoder-js": "^1.0.1",
    "rollup": "^0.36.3",
    "rollup-plugin-node-resolve": "^2.0.0",
    "rollup-plugin-commonjs": "^5.0.5",
    "typescript": "~5.9.3",
    "uglify-js": "^2.7.4",
    "xhr2": "^0.1.3"
  },
  "types": "build/types/index.d.ts",
  "files": [
    "build/mmdparser.js",
    "build/mmdparser.min.js",
    "build/mmdparser.module.js",
    "build/mmdparser.module.mjs",
    "build/types/"
  ]
}
